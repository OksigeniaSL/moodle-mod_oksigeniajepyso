{{!
    @template mod_oksigeniajepyso/report

    The follow-up of an activity: a row for each student, with the sessions done and what there is to look at, the days
    above the acceptable discomfort first. On a phone, each row is a card.

    Context variables required for this template:
    * hasstudents - Whether there is anyone to show
    * students - Each with picture (HTML), fullname, url, sessions, hastarget, twentieths, last, nosessions, hasflagged,
      hasalerts and alerts (each with alerttext and alertstrong)

    Example context (json):
    {
        "hasstudents": true,
        "students": [
            {
                "picture": "<img src=\"https://example.com/pix/u/f2.png\" class=\"userpicture\" width=\"35\" height=\"35\" alt=\"\">",
                "fullname": "Ana Martín",
                "url": "https://example.com/mod/oksigeniajepyso/report.php?id=1&userid=3",
                "sessions": "2 de 6",
                "hastarget": true,
                "twentieths": 6,
                "last": "15 de noviembre de 2026",
                "nosessions": false,
                "hasflagged": true,
                "hasalerts": true,
                "alerts": [
                    {"alerttext": "1 día por encima de la aceptable", "alertstrong": true},
                    {"alerttext": "2 notas", "alertstrong": false}
                ]
            }
        ]
    }
}}
<div class="mod-oksigeniajepyso-followup">
{{#hasstudents}}
    <table class="table-reboot mod-oksigeniajepyso-report">
        <thead>
            <tr>
                <th scope="col">{{#str}}student, mod_oksigeniajepyso{{/str}}</th>
                <th scope="col">{{#str}}sessionsdone, mod_oksigeniajepyso{{/str}}</th>
                <th scope="col">{{#str}}lastsessionheader, mod_oksigeniajepyso{{/str}}</th>
                <th scope="col">{{#str}}tolookat, mod_oksigeniajepyso{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#students}}
            <tr class="{{#hasflagged}}is-flagged{{/hasflagged}}">
                <th scope="row"><span class="mod-oksigeniajepyso-who">{{{picture}}}<a href="{{url}}">{{fullname}}</a></span></th>
                <td data-label="{{#str}}sessionsdone, mod_oksigeniajepyso{{/str}}">
                    <span class="mod-oksigeniajepyso-count">{{sessions}}</span>
                    {{#hastarget}}
                    <span class="mod-oksigeniajepyso-bar is-small" data-twentieths="{{twentieths}}" aria-hidden="true"><span></span></span>
                    {{/hastarget}}
                </td>
                <td class="mod-oksigeniajepyso-when{{#nosessions}} mod-oksigeniajepyso-quiet{{/nosessions}}" data-label="{{#str}}lastsessionheader, mod_oksigeniajepyso{{/str}}">{{last}}</td>
                <td data-label="{{#str}}tolookat, mod_oksigeniajepyso{{/str}}">
                    {{#hasalerts}}
                    <ul class="mod-oksigeniajepyso-alerts">
                        {{#alerts}}
                        <li class="mod-oksigeniajepyso-tag{{#alertstrong}} is-strong{{/alertstrong}}">{{alerttext}}</li>
                        {{/alerts}}
                    </ul>
                    {{/hasalerts}}
                    {{^hasalerts}}
                    <span class="mod-oksigeniajepyso-quiet">{{#str}}nothingtolookat, mod_oksigeniajepyso{{/str}}</span>
                    {{/hasalerts}}
                </td>
            </tr>
            {{/students}}
        </tbody>
    </table>
{{/hasstudents}}
{{^hasstudents}}
    <p class="mod-oksigeniajepyso-empty">{{#str}}nostudents, mod_oksigeniajepyso{{/str}}</p>
{{/hasstudents}}
</div>

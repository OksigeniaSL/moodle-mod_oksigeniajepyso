{{!
    @template mod_oksigeniajepyso/index

    The activities of a course.

    Context variables required for this template:
    * sectionlabel - The name of the column of the sections
    * activities - Each with section, url, name, sessions and dimmed

    Example context (json):
    {
        "sectionlabel": "Topic",
        "activities": [
            {
                "section": "Topic 1",
                "url": "https://example.com/mod/oksigeniajepyso/view.php?id=7",
                "name": "Strength routine",
                "sessions": "6",
                "dimmed": false
            }
        ]
    }
}}
<table class="generaltable mod_index">
    <thead>
        <tr>
            <th scope="col">{{sectionlabel}}</th>
            <th scope="col">{{#str}}name{{/str}}</th>
            <th scope="col">{{#str}}sessions, mod_oksigeniajepyso{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#activities}}
        <tr>
            <td>{{{section}}}</td>
            <td><a{{#dimmed}} class="dimmed"{{/dimmed}} href="{{url}}">{{{name}}}</a></td>
            <td>{{sessions}}</td>
        </tr>
        {{/activities}}
    </tbody>
</table>

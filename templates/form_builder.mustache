{{!
    @template mod_oksigeniajepyso/form_builder

    In the form of the activity, over the field of the routine: the way into the builder. Without JavaScript the link
    opens it in another tab.

    Context variables required for this template:
    * url - The address of the builder

    Example context (json):
    {
        "url": "https://example.com/mod/oksigeniajepyso/builder.php?course=2"
    }
}}
<span class="mod-oksigeniajepyso-launch"><a class="btn mod-oksigeniajepyso-button is-secondary" id="mod_oksigeniajepyso_build" href="{{url}}" target="jepyso-armar" rel="opener">{{#str}}buildroutine, mod_oksigeniajepyso{{/str}}</a><span class="mod-oksigeniajepyso-hint">{{#str}}buildroutinehint, mod_oksigeniajepyso{{/str}}</span></span>
